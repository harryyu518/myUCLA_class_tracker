# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git.

# Optional notifications
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_API_URL=https://api.pushover.net/1/messages.json

# ClassSearch targets (set as many as needed, leave unused slots blank)
CLASSSEARCH_URL_1=
CLASSSEARCH_URL_2=
CLASSSEARCH_URL_3=
CLASSSEARCH_URL_4=
CLASSSEARCH_URL_5=
CLASSSEARCH_URL_6=
CLASSSEARCH_URL_7=
CLASSSEARCH_URL_8=
CLASSSEARCH_URL_9=
CLASSSEARCH_URL_10=

# ClassPlanner settings
CLASSPLANNER_URL=https://be.my.ucla.edu/ClassPlanner/ClassPlan.aspx
CLASSPLANNER_LOGIN_URL=https://be.my.ucla.edu/studylist.aspx
CLASSPLANNER_CSS_SELECTOR=#ctl00_MainContent_panelGrid

# Required monitor/runtime settings
CLASSSEARCH_POLL_INTERVAL=5
CLASSPLANNER_POLL_INTERVAL=180
MAX_SNAPSHOTS_TO_KEEP=5
PLAYWRIGHT_TIMEOUT=60000
PLAYWRIGHT_HEADLESS=true

# Optional VM connection settings for ./reauth_vm.sh (local orchestrator mode)
# VM_IP=
# VM_USER=ubuntu
# SSH_KEY=~/.ssh/id_ed25519
# REMOTE_REPO=~/myucla_tracker
# SYNC_VM_SNAPSHOTS=1
# LOCAL_SNAPSHOTS_DIR=./snapshots/vm
