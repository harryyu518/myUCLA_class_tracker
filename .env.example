# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git.

# Optional notifications
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_API_URL=https://api.pushover.net/1/messages.json

# Optional monitor tuning
CLASSSEARCH_POLL_INTERVAL=60
MAX_SNAPSHOTS_TO_KEEP=5
PLAYWRIGHT_TIMEOUT=60000
PLAYWRIGHT_HEADLESS=true

# ClassSearch URL slots (up to 10)
CLASSSEARCH_URL_1=
CLASSSEARCH_URL_2=
CLASSSEARCH_URL_3=
CLASSSEARCH_URL_4=
CLASSSEARCH_URL_5=
CLASSSEARCH_URL_6=
CLASSSEARCH_URL_7=
CLASSSEARCH_URL_8=
CLASSSEARCH_URL_9=
CLASSSEARCH_URL_10=
